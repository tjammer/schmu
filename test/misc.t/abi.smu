type v2 = {z : float, y : float}
type i2 = {x : int, y : int}
type i1 = {x : int}
type v1 = {z : float}
type v3 = {x : float, y : float, z : float}
type i3 = {w : int, y : int, z : int}
type v4 = {x : float, y : float, z : float, w : float}
type mixed4 = {x : float, y : float, z : float, k : int}
type trailv2 = {a : int, b : int, c : float, d : float}
type f2s = {fx : f32, fy : f32}
type f3s = {fx : f32, fy : f32, fz : f32}
type shader = {id : i32, locs : raw_ptr[i32]}

external subv2 : fun (v2) ->  v2
external subi2 : fun (i2) ->  i2
external subv1 : fun (v1) ->  v1
external subi1 : fun (i1) ->  i1
external subv3 : fun (v3) ->  v3
external subi3 : fun (i3) ->  i3
external subv4 : fun (v4) ->  v4
external submixed4 : fun (mixed4) ->  mixed4
external subtrailv2 : fun (trailv2) ->  trailv2
external subf2s : fun (f2s) ->  f2s
external subf3s : fun (f3s) ->  f3s
external load_shader : fun (string/cstr, string/cstr) -> shader
external set_shader_value : fun (shader, i32, v4) -> unit

type pad_next = {a : u16, b : u8, c : int}
type pad_tail = {a : float, b : i16, c : i8}
type pad_tail2 = {a : float, b : u8, c : u8}
type single_tail = {a : float, b : u8}
type single_word = {a : u8, b : i16}
external subpad_next : fun (pad_next) -> pad_next
external subpad_tail : fun (pad_tail) -> pad_tail
external subpad_tail2 : fun (pad_tail2) -> pad_tail2
external subsingle_tail : fun (single_tail) -> single_tail
external subsingle_word : fun (single_word) -> single_word

external spill4 : fun (i2, i2, i2, i2) -> i2
external spill_sse : fun (v2, v2, v2, v2, float) -> unit
external spill_mixed : fun (i2, i2, i2, v2) -> unit
external spill_mid : fun (int, i2, i2, i2) -> unit

external spill_one_word : fun (i2, i2, i2, i1) -> unit
external spill_one_sse : fun (i2, i2, i2, v1) -> unit

type turn = Left
type input = { wheel : float, turn : option[turn] }
external subinput : fun (input) -> input

type inner = { a : i16, b : i8 }
type outer = { w : float, x : inner }
type pad_after_nested = { w : float, x : inner, y : i8, z : u16, v : u8 }
external subouter : fun (outer) -> outer
external subpad_after_nested : fun (pad_after_nested) -> pad_after_nested

type f1 = { a : f32 }
type nested_fv = { x : f1, y : f32 }
external subnested_fv : fun (nested_fv, i8, f1) -> nested_fv

ignore (subv2 ({z = 1.0, y = 10.0}))
ignore (subi2 ({x = 1, y = 10 }))
ignore (subv1 ({z = 1.0}))
ignore (subi1 ({x = 1 }))
ignore (subv3 ({x = 1.0, y = 10.0, z = 100.0 }))
ignore (subi3 ({w = 1, y = 10, z = 100 }))
ignore (subv4 ({x = 1.0, y = 10.0, z = 100.0, w = 1000.0}))
ignore (submixed4 ({x = 1.0, y = 10.0, z = 100.0, k = 1 }))
ignore (subtrailv2 ({a = 1, b = 2, c = 1.0, d = 2.0 }))
ignore (subf2s ({fx = 2.0f32, fy = 3.0f32}))
ignore (subf3s ({fx = 2.0f32, fy = 3.0f32, fz = 5.0f32}))
load_shader("a" |> cstr, "b" |> cstr) |> ignore
set_shader_value({id = 0i32, locs = __unsafe_ptr_reinterpret(__unsafe_nullptr())},
                 0i32, {x = 1.0, y = 10.0, z = 100.0, w = 1000.0})
ignore (subpad_next ({a = u16_of_int(1), b = 1u8, c = 1}))
ignore (subpad_tail ({a = 1.0, b = i16_of_int(1), c = i8_of_int(1)}))
ignore (subpad_tail2 ({a = 1.0, b = 1u8, c = 1u8}))
ignore (subsingle_tail ({a = 1.0, b = 1u8}))
ignore (subsingle_word ({a = 1u8, b = i16_of_int(1)}))
ignore (spill4 ({x = 1, y = 2}, {x = 3, y = 4}, {x = 5, y = 6}, {x = 7, y = 8}))
spill_sse({z = 1.0, y = 2.0}, {z = 3.0, y = 4.0}, {z = 5.0, y = 6.0},
          {z = 7.0, y = 8.0}, 9.0)
spill_mixed({x = 1, y = 2}, {x = 3, y = 4}, {x = 5, y = 6}, {z = 1.0, y = 2.0})
spill_mid(1, {x = 2, y = 3}, {x = 4, y = 5}, {x = 6, y = 7})
spill_one_word({x = 1, y = 2}, {x = 3, y = 4}, {x = 5, y = 6}, {x = 7})
spill_one_sse({x = 1, y = 2}, {x = 3, y = 4}, {x = 5, y = 6}, {z = 7.0})
ignore (subinput ({wheel = 1.0, turn = Some (Left)}))
ignore (subouter ({w = 1.0, x = {a = i16_of_int(1), b = i8_of_int(2)}}))
ignore (subpad_after_nested ({w = 1.0, x = {a = i16_of_int(1), b = i8_of_int(2)},
                              y = i8_of_int(3), z = u16_of_int(4), v = 5u8}))
ignore (subnested_fv ({x = {a = 1.0f32}, y = 2.0f32}, i8_of_int(1), {a = 3.0f32}))
